# =============================================================================
# .env.example — committed template of app configuration.
# On Windows, setup.bat copies this file and replaces both placeholders with
# random local values. On other systems, copy it to `.env` and edit it manually.
# Core keys are required. GOOGLE_CLIENT_ID is optional and an empty value keeps
# Google sign-in disabled. Never commit your real `.env`.
# =============================================================================

# Core Settings
PROJECT_NAME="backend-playground"
API_V1_STR="/api/v1"

# Docker Postgres Variables
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="fastapi_db"

# Python Database URL (must match the Postgres vars above)
DATABASE_URL="postgresql+asyncpg://postgres:change-me@localhost:5432/fastapi_db"

# Redis (session denylist / login rate-limit counters / shared cache)
REDIS_URL="redis://localhost:6379/0"

# Security
# Generate a strong secret:  python3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Public OAuth Web Client ID; use the same value in the Angular environment.
GOOGLE_CLIENT_ID=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# Login brute-force protection (Redis-backed)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5      # failed attempts before lockout
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900  # lockout / counting window (15 minutes)

# Registration throttle per source IP (Redis-backed)
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=10     # signups per IP before lockout
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600 # counting window (1 hour)

# Google sign-in throttle per source IP (protects outbound token verification)
GOOGLE_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=30
GOOGLE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_VERIFICATION_MAX_CONCURRENCY=8

# Allowed CORS origins (JSON array of strings)
ORIGINS_API='["http://localhost:4200", "http://localhost:3000"]'

# Proxy IPs allowed to supply X-Forwarded-For; keep empty for direct local access.
TRUSTED_PROXY_IPS='[]'
